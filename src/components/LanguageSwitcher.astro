---
interface Props {
  lang: string;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;

// Compute alternate language URL
let altPath = currentPath;
if (currentPath.startsWith('/en/')) {
  altPath = currentPath.replace('/en/', '/');
} else if (currentPath.startsWith('/en')) {
  altPath = '/';
} else if (!currentPath.startsWith('/en')) {
  // PT-BR path -> try to find EN equivalent
  const slug = currentPath.replace(/^\/blog\//, '').replace(/\/$/, '');
  altPath = slug ? `/en/blog/${slug}` : '/en';
}
---
<nav class="lang-switcher" aria-label="Language switcher">
  <a href="/" class={lang !== 'en' ? 'active' : ''}>PT</a>
  <a href="/en" class={lang === 'en' ? 'active' : ''}>EN</a>
</nav>
