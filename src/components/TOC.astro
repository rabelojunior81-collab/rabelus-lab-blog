---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;
const filtered = headings.filter(h => h.depth >= 2 && h.depth <= 3);
---
{filtered.length > 0 && (
  <aside class="toc-sidebar">
    <div class="toc-label">Contents</div>
    <ul class="toc-list">
      {filtered.map(h => (
        <li>
          <a href={`#${h.slug}`} class={h.depth === 3 ? 'toc-h3' : ''}>
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}
{filtered.length === 0 && (
  <aside class="toc-sidebar"></aside>
)}
