---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import TOC from '../components/TOC.astro';
import TagList from '../components/TagList.astro';

interface Props {
  title: string;
  subtitle?: string;
  author: string;
  date: string;
  lang: string;
  tags: string[];
  image?: string;
  headings: { depth: number; slug: string; text: string }[];
  readingTime: number;
}

const { title, subtitle, author, date, lang, tags, image, headings, readingTime } = Astro.props;
const siteUrl = 'https://rabelus.com.br';
const currentPath = Astro.url.pathname;
const description = subtitle || title;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | Rabelus Lab Blog</title>
  <meta name="description" content={description} />
  <meta name="author" content={author} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title="Rabelus Lab Blog" href="/rss.xml" />
  <meta property="og:type" content="article" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={siteUrl + currentPath} />
  {image && <meta property="og:image" content={siteUrl + image} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {image && <meta name="twitter:image" content={siteUrl + image} />}
</head>
<body>
  <Header lang={lang} currentPath={currentPath} />
  <div class="layout">
    <Sidebar lang={lang} currentPath={currentPath} />
    <main class="main-content">
      <article>
        <header class="article-header">
          {image && <img src={image} alt={title} class="article-hero" />}
          <h1 class="article-title">{title}</h1>
          {subtitle && <p class="article-subtitle">{subtitle}</p>}
          <div class="article-meta">
            <span class="author">{author}</span>
            <span>&mdash;</span>
            <span class="date">{date}</span>
            <span>&mdash;</span>
            <span class="reading-time">{readingTime} min read</span>
          </div>
          <TagList tags={tags} lang={lang} />
        </header>
        <div class="prose">
          <slot />
        </div>
      </article>
    </main>
    <TOC headings={headings} />
  </div>
  <footer>
    <p>Rabelus Lab Blog &mdash; <a href="/rss.xml">RSS</a> &mdash; &copy; {new Date().getFullYear()}</p>
  </footer>
</body>
</html>
