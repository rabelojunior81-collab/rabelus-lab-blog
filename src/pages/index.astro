---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';

const posts = (await getCollection('blog', entry => entry.id.startsWith('pt/')))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

function readingTime(body: string) {
  const words = body.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
}
---
<BaseLayout title="Rabelus Lab Blog" lang="pt-BR">
  <div class="page-title">&gt; rabelus.lab/blog</div>
  <p class="page-subtitle">Pesquisa e Desenvolvimento AI-Born/Driven/First</p>
  {posts.map(post => (
    <PostCard
      title={post.data.title}
      subtitle={post.data.subtitle}
      date={post.data.date}
      slug={post.data.postSlug}
      tags={post.data.tags}
      lang="pt-BR"
      readingTime={readingTime(post.body ?? '')}
    />
  ))}
</BaseLayout>
