---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', entry => entry.id.startsWith('pt/'));
  const tags = [...new Set(posts.flatMap(p => p.data.tags))];
  return tags.map(tag => ({
    params: { tag },
    props: { tag, posts: posts.filter(p => p.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
const sorted = posts.sort((a: any, b: any) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

function readingTime(body: string) {
  const words = body.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
}
---
<BaseLayout title={`Tag: ${tag}`} lang="pt-BR">
  <div class="page-title">&gt; #{ tag }</div>
  <p class="page-subtitle">{sorted.length} post(s)</p>
  {sorted.map((post: any) => (
    <PostCard
      title={post.data.title}
      subtitle={post.data.subtitle}
      date={post.data.date}
      slug={post.data.postSlug}
      tags={post.data.tags}
      lang="pt-BR"
      readingTime={readingTime(post.body ?? '')}
    />
  ))}
</BaseLayout>
